INTERLIS 2.3;

TYPE MODEL GeometryCHLV03_V1 (en) AT "https://example.org" VERSION "2026-01-01" =
  DOMAIN
    !!@CRS=EPSG:21781
    Coord2 = COORD 460000.000 .. 870000.000, 45000.000 .. 310000.000;
    Surface = SURFACE WITH (STRAIGHTS, ARCS) VERTEX Coord2 WITHOUT OVERLAPS > 0.001;

  STRUCTURE SurfaceStructure =
    Surface : Surface;
  END SurfaceStructure;
  STRUCTURE MultiSurface =
    Surfaces : BAG {1..*} OF SurfaceStructure;
  END MultiSurface;
END GeometryCHLV03_V1.

MODEL ChbaseSurfaces23 (en) AT "https://example.org" VERSION "2026-01-01" =
  IMPORTS GeometryCHLV03_V1;
  TOPIC Data =
    CLASS LandCover =
      Shape : GeometryCHLV03_V1.MultiSurface;
    END LandCover;
  END Data;
END ChbaseSurfaces23.
