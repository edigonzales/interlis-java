INTERLIS 2.3;

TYPE MODEL GeometryCHLV95_V1 (en) AT "https://example.org" VERSION "2026-01-01" =
  DOMAIN
    !!@CRS=EPSG:2056
    Coord2 = COORD 2460000.000 .. 2870000.000, 1045000.000 .. 1310000.000;
    Line = POLYLINE WITH (STRAIGHTS, ARCS) VERTEX Coord2;
    DirectedLine EXTENDS Line = DIRECTED POLYLINE;

  STRUCTURE LineStructure =
    Line : Line;
  END LineStructure;
  STRUCTURE DirectedLineStructure =
    Line : DirectedLine;
  END DirectedLineStructure;
  STRUCTURE MultiLine =
    Lines : BAG {1..*} OF LineStructure;
  END MultiLine;
  STRUCTURE MultiDirectedLine =
    Lines : BAG {1..*} OF DirectedLineStructure;
  END MultiDirectedLine;
END GeometryCHLV95_V1.

MODEL ChbaseLines23 (en) AT "https://example.org" VERSION "2026-01-01" =
  IMPORTS GeometryCHLV95_V1;
  TOPIC Data =
    CLASS PipeRoute =
      Shape : GeometryCHLV95_V1.MultiLine;
    END PipeRoute;
    CLASS FlowRoute =
      Shape : GeometryCHLV95_V1.MultiDirectedLine;
    END FlowRoute;
  END Data;
END ChbaseLines23.
