INTERLIS 2.4;

TYPE MODEL ChbaseSurfaceTypes24 (en) AT "https://example.org" VERSION "2026-01-01" =
  DOMAIN
    !!@CRS=EPSG:21781
    Coord2 = COORD 460000.000 .. 870000.000, 45000.000 .. 310000.000;
    Surface = SURFACE WITH (STRAIGHTS, ARCS) VERTEX Coord2 WITHOUT OVERLAPS > 0.001;

  STRUCTURE SurfaceStructure =
    Surface : Surface;
  END SurfaceStructure;
  !!@ili2db.mapping=MultiSurface
  STRUCTURE MultiSurface =
    Surfaces : BAG {1..*} OF SurfaceStructure;
  END MultiSurface;
END ChbaseSurfaceTypes24.

MODEL ChbaseSurfaces24 (en) AT "https://example.org" VERSION "2026-01-01" =
  IMPORTS ChbaseSurfaceTypes24;
  TOPIC Data =
    CLASS LandCover =
      Shape : ChbaseSurfaceTypes24.MultiSurface;
    END LandCover;
  END Data;
END ChbaseSurfaces24.
