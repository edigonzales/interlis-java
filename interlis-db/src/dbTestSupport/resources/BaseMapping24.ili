INTERLIS 2.4;

!!@ CRS=EPSG:21781
MODEL BaseMapping24 (en) AT "https://example.org/interlis/db" VERSION "2026-11-20" =
  DOMAIN
    !!@ CRS=EPSG:02056
    Position = COORD 2460000.000 .. 2870000.000, 1045000.000 .. 1310000.000;
    !!@ CRS=EPSG:02056
    RoutePosition = COORD 2450000.500 .. 2880000.250, 1040000.125 .. 1320000.750;
    !!@ CRS=EPSG:02056
    PlotPosition = COORD 2440000.125 .. 2885000.750, 1035000.500 .. 1325000.250;
    !!@ CRS=EPSG:02056
    SurveyPositions = MULTICOORD 2460000.125 .. 2870000.750, 1045000.500 .. 1310000.250;
    Approval = (draft, approved);

  STRUCTURE Detail =
    Label : TEXT*16;
    Enabled : BOOLEAN;
    Quantity : -20 .. 20;
    Decision : (draft, approved);
  END Detail;

  TOPIC Data =
    !!@ ili2db.dispName="Places"
    CLASS Place =
      !!@ ili2db.dispName="Label"
      Select : TEXT*40;
      Active : BOOLEAN;
      Count : -100 .. 100;
      Status : Approval;
      Geometry : Position;
    END Place;
    CLASS Route =
      Trace : POLYLINE WITH (STRAIGHTS, ARCS) VERTEX RoutePosition;
    END Route;
    CLASS Link =
      Target : REFERENCE TO Place;
    END Link;
    CLASS Plot =
      Footprint : SURFACE WITH (STRAIGHTS, ARCS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END Plot;
    CLASS Parcel =
      Boundary : AREA WITH (STRAIGHTS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END Parcel;
    CLASS Park =
      Coverage : MULTISURFACE WITH (STRAIGHTS, ARCS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END Park;
    CLASS District =
      Coverage : MULTIAREA WITH (STRAIGHTS, ARCS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END District;
    CLASS RouteGroup =
      Traces : MULTIPOLYLINE WITH (STRAIGHTS, ARCS) VERTEX RoutePosition;
    END RouteGroup;
    CLASS Survey =
      Locations : SurveyPositions;
    END Survey;
    STRUCTURE LinkDetail =
      Label : TEXT*16;
      Destination : REFERENCE TO Place;
    END LinkDetail;
    STRUCTURE NestedLeaf =
      Amount : 0 .. 10;
    END NestedLeaf;
    STRUCTURE NestedInner =
      Headline : TEXT*16;
      Main : NestedLeaf;
      Values : LIST {0..*} OF NestedLeaf;
      Extras : BAG {0..*} OF NestedLeaf;
    END NestedInner;
    STRUCTURE NestedOuter =
      Items : LIST {0..*} OF NestedInner;
    END NestedOuter;
    CLASS NestedRecord =
      Tree : NestedOuter;
    END NestedRecord;
    STRUCTURE NoteBase =
      Label : TEXT*16;
    END NoteBase;
    STRUCTURE CountNote EXTENDS NoteBase =
      Amount : 0 .. 10;
    END CountNote;
    STRUCTURE FlagNote EXTENDS NoteBase =
      Enabled : BOOLEAN;
    END FlagNote;
    STRUCTURE NoteKind (ABSTRACT) =
      Label : TEXT*16;
    END NoteKind;
    STRUCTURE NamedNote EXTENDS NoteKind =
      Code : TEXT*8;
    END NamedNote;
    CLASS TypedRecord =
      Main : CountNote;
      Values : LIST {0..*} OF NoteBase;
      Extras : BAG {0..*} OF NoteKind;
    END TypedRecord;
    CLASS Report =
      Summary : Detail;
      Entries : LIST {0..*} OF Detail;
      Observations : BAG {0..*} OF Detail;
      Links : LIST {0..*} OF LinkDetail;
    END Report;
    CLASS Marker =
      ASelect : TEXT*16;
    END Marker;
    CLASS Hub =
    END Hub;
    ASSOCIATION MarkerHub =
      Markers -- {0..*} Marker;
      Select -- {0..1} Hub;
    END MarkerHub;
    ASSOCIATION MarkerLink =
      LinkedHub -- {0..*} Hub;
      LinkedMarker -- {0..*} Marker;
    END MarkerLink;
    ASSOCIATION Review =
      Witness -- {0..1} Hub;
      ReviewMarkers -- {0..*} Marker;
      Memo : TEXT*16;
      Grade : -8 .. 8;
    END Review;
    ASSOCIATION AnnotatedLink =
      ConsultedMarker -- {0..*} Marker;
      ConsultedReport -- {0..*} Report;
      Memo : TEXT*16;
      Grade : -8 .. 8;
      LocalDecision : (draft, approved);
    END AnnotatedLink;
    CLASS PairLeft =
    END PairLeft;
    CLASS PairRight =
    END PairRight;
    ASSOCIATION Pairing =
      RightLink -- {0..1} PairRight;
      LeftLink -- {1} PairLeft;
    END Pairing;
    CLASS Mast =
      Caption : TEXT*32;
      Notes : LIST {0..*} OF NestedLeaf;
      Center : Position;
    END Mast;
    CLASS Tower EXTENDS Mast =
      Height : 0 .. 99;
      SerialNumber : 0 .. 50000000000;
      Tilt : -90.00 .. 90.00;
      Supplement : NestedOuter;
      Alignment : POLYLINE WITH (STRAIGHTS, ARCS) VERTEX RoutePosition;
    END Tower;
    CLASS Relay EXTENDS Tower =
      Height (EXTENDED) : 0 .. 49;
      SerialNumber (EXTENDED) : 0 .. 40000000000;
      Tilt (EXTENDED) : -9.99 .. 9.99;
      Online : BOOLEAN;
      Sites : SurveyPositions;
    END Relay;
    CLASS Beacon EXTENDS Mast =
      Signal : (red, green);
    END Beacon;
    CLASS ServiceBase (ABSTRACT) =
      ServiceCode : TEXT*12;
      ServicePoint : Position;
    END ServiceBase;
    CLASS ServiceUnit EXTENDS ServiceBase =
      Label : TEXT*18;
    END ServiceUnit;
    ASSOCIATION HierarchyCrew =
      Supervisor -- {0..1} Tower;
      Crewmember -- {0..*} ServiceBase;
    END HierarchyCrew;
    ASSOCIATION HierarchyPair =
      PairedTower -- {0..1} Tower;
      PairedService -- {0..1} ServiceBase;
    END HierarchyPair;
    ASSOCIATION MastMentoring =
      Mentor -- {0..1} Mast;
      Mentee -- {0..*} Tower;
    END MastMentoring;
    ASSOCIATION HierarchyLink =
      WorkBranch -- {0..*} Tower;
      StaffRoot -- {0..*} ServiceBase;
    END HierarchyLink;
    ASSOCIATION HierarchyNote =
      RaisedAt -- {0..*} Mast;
      SharedAt -- {0..*} ServiceBase;
      Memo : TEXT*12;
      Severity : (minor, major);
    END HierarchyNote;
    ASSOCIATION DispatchRecord =
      DispatchLeft -- {0..*} PairLeft;
      DispatchLocation -- {0..*} Place;
      DispatchMast -- {0..*} Tower;
      Memo : TEXT*12;
      Severity : (minor, major);
    END DispatchRecord;
    STRUCTURE TargetPair =
      Label : TEXT*12;
      RootTarget : REFERENCE TO ServiceBase;
      BranchTarget : REFERENCE TO Tower;
    END TargetPair;
    CLASS RefCarrier =
      DirectRoot : REFERENCE TO ServiceBase;
      DirectBranch : REFERENCE TO Tower;
      Pairs : LIST {0..*} OF TargetPair;
    END RefCarrier;
    ASSOCIATION ServiceAggregation =
      GroupWhole -<> {0..*} RefCarrier;
      GroupPart -- {0..*} ServiceBase;
    END ServiceAggregation;
    ASSOCIATION MastOwnership =
      WholeMast -<#> {0..1} Mast;
      ServicePart -- {0..*} ServiceBase;
    END MastOwnership;
    STRUCTURE RefNoteBase =
      Label : TEXT*12;
      RootTarget : REFERENCE TO Mast;
    END RefNoteBase;
    STRUCTURE RefNoteBranch EXTENDS RefNoteBase =
      BranchTarget : REFERENCE TO Tower;
    END RefNoteBranch;
    STRUCTURE RefNoteLeaf EXTENDS RefNoteBranch =
      OwnTarget : REFERENCE TO Mast;
    END RefNoteLeaf;
    CLASS RefNoteBook =
      Entries : LIST {0..*} OF RefNoteBase;
    END RefNoteBook;
    CLASS RefAssetBase =
      Label : TEXT*12;
      RootTarget : REFERENCE TO Mast;
    END RefAssetBase;
    CLASS RefAssetBranch EXTENDS RefAssetBase =
      BranchTarget : REFERENCE TO Tower;
    END RefAssetBranch;
    CLASS RefAssetLeaf EXTENDS RefAssetBranch =
      OwnTarget : REFERENCE TO Mast;
    END RefAssetLeaf;
    CLASS RatingForm =
    END RatingForm;
    ASSOCIATION Rating =
      Rated -- {0..1} Tower;
      RatingForms -- {0..*} RatingForm;
      Memo : TEXT*16;
    END Rating;
    ASSOCIATION RelayReview =
      Recommended -- {0..1} ServiceBase;
      ReviewingRelays -- {0..*} Relay;
      Memo : TEXT*16;
    END RelayReview;
    ASSOCIATION RatingTag =
      TaggedForm -- {0..1} RatingForm;
      TaggedUnit -- {0..1} ServiceUnit;
      Memo : TEXT*16;
    END RatingTag;
    CLASS ContractSite =
    END ContractSite;
    CLASS ContractSigner =
    END ContractSigner;
    ASSOCIATION AllocationBase (ABSTRACT) =
      ListedSite -- {0..*} ContractSite;
      ListedSigner -- {0..*} ContractSigner;
      BaseNote : TEXT*40;
    END AllocationBase;
    ASSOCIATION TaggedAllocation EXTENDS AllocationBase =
      DetailRank : 0 .. 20;
    END TaggedAllocation;
  END Data;

  TOPIC Naming =
    CLASS place =
      Select : TEXT*40;
      ASelect : TEXT*40;
      LongAttributeNameWithAnUnusuallyLongMiddleSectionForTestingShorteningAboveTheLimit : TEXT;
    END place;
    CLASS LongClassNameWithAnUnusuallyLongMiddleSectionForTestingShorteningAboveTheLimit =
      Number : 0 .. 5;
    END LongClassNameWithAnUnusuallyLongMiddleSectionForTestingShorteningAboveTheLimit;
  END Naming;
END BaseMapping24.
