INTERLIS 2.3;
MODEL TownParent23 AT "https://example.org/town" VERSION "1" =
IMPORTS TownShared23;
TOPIC Core =
  STRUCTURE Entry = Note : TEXT*30; END Entry;
  CLASS Station =
    Memo : TEXT*30;
    Detail : Entry;
    History : LIST {0..*} OF Entry;
    Inspection : TownShared23.Inspection;
    Center : COORD 2480000.000 .. 2840000.000, 1070000.000 .. 1300000.000;
  END Station;
  STRUCTURE StationLink =
    Caption : TEXT*30;
    RelatedStation : REFERENCE TO Station;
  END StationLink;
  CLASS Marker =
    Memo : TEXT*30;
    Detail : Entry;
    Observations : BAG {0..*} OF Entry;
    LinkNotes : LIST {0..*} OF StationLink;
  END Marker;
  ASSOCIATION Location =
    LocatedAt -- {0..1} Marker;
    LocatedStation -- {0..*} Station;
  END Location;
  ASSOCIATION Visit =
    VisitedMarker -- {0..*} Marker;
    VisitingStation -- {0..*} Station;
    VisitNote : TEXT*30;
  END Visit;
END Core;
TOPIC Other = CLASS Spare = END Spare; END Other;
END TownParent23.
