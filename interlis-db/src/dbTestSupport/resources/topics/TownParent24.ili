INTERLIS 2.4;
MODEL TownParent24 AT "https://example.org/town" VERSION "1" =
TOPIC Core =
  STRUCTURE Entry = Note : TEXT*30; END Entry;
  CLASS Marker = Memo : TEXT*30; Detail : Entry; END Marker;
  CLASS Station =
    Memo : TEXT*30;
    Detail : Entry;
    History : LIST {0..*} OF Entry;
    Center : COORD 2480000.000 .. 2840000.000, 1070000.000 .. 1300000.000;
  END Station;
END Core;
TOPIC Other = CLASS Spare = END Spare; END Other;
END TownParent24.
