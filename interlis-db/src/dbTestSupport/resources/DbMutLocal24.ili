INTERLIS 2.4;
MODEL DbMutLocal24 (en) AT "https://example.org/interlis/db" VERSION "1" =
  TOPIC Data =
    CLASS MutationTarget =
      Label : TEXT*40;
    END MutationTarget;
    STRUCTURE MutationLink =
      Destination : REFERENCE TO MutationTarget;
    END MutationLink;
    CLASS MutationRecord =
      Label : TEXT*40;
      Detail : MutationLink;
    END MutationRecord;
  END Data;
END DbMutLocal24.
