INTERLIS 2.3;
MODEL DbSpatial23 (en) AT "https://example.org/interlis/db" VERSION "1" =
  DOMAIN Position = COORD 2460000.000 .. 2870000.000, 1045000.000 .. 1310000.000;
  TOPIC Data =
    CLASS LinearAsset =
      Label : TEXT*20;
    END LinearAsset;
    CLASS IndexedLine EXTENDS LinearAsset =
      Trace : POLYLINE WITH (STRAIGHTS, ARCS) VERTEX Position;
    END IndexedLine;
    CLASS IndexedPlot =
      Footprint : SURFACE WITH (STRAIGHTS, ARCS) VERTEX Position WITHOUT OVERLAPS > 0.001;
    END IndexedPlot;
    CLASS IndexedArea =
      Boundary : AREA WITH (STRAIGHTS) VERTEX Position WITHOUT OVERLAPS > 0.001;
    END IndexedArea;
  END Data;
END DbSpatial23.
