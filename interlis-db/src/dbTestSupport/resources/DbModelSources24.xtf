        <Name>Imported domains</Name><State>active</State>
        <Location><g:coord><g:c1>2600123.125</g:c1><g:c2>1200456.375</g:c2></g:coord></Location>
      </Station>
    </Data>
    <Data xmlns="http://www.interlis.ch/xtf/2.4/DbStoredImports24" i:bid="fixture-stored-basket">
