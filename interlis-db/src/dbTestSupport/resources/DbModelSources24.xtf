        <Entries><d:Detail><d:Label>second</d:Label></d:Detail><d:Detail><d:Label>first</d:Label></d:Detail></Entries>
        <Observations><d:Detail><d:Label>same</d:Label></d:Detail><d:Detail><d:Label>same</d:Label></d:Detail></Observations>
