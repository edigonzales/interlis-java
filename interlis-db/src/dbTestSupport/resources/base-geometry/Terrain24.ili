INTERLIS 2.4;
MODEL Terrain24 (en) AT "https://example.org/interlis/db" VERSION "1" =
  DOMAIN
    Position = COORD 2460000.000 .. 2870000.000, 1045000.000 .. 1310000.000, -100.000 .. 1000.000;
  TOPIC Data =
    CLASS Track =
      Trace : POLYLINE WITH (STRAIGHTS, ARCS) VERTEX Position;
    END Track;
  END Data;
END Terrain24.
