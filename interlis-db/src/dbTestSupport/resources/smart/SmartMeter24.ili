INTERLIS 2.4;

MODEL SmartMeter24 AT "https://example.org/smart" VERSION "1" =
  TOPIC Data =
    CLASS Instrument (ABSTRACT) =
      Memo : TEXT*40;
      State : (active, idle);
    END Instrument;
    CLASS Meter EXTENDS Instrument =
      Counter : 0..100;
    END Meter;
    CLASS SmartUnit EXTENDS Meter =
      Badge : TEXT*12;
    END SmartUnit;
    CLASS Terminal EXTENDS Instrument =
      Socket : TEXT*12;
    END Terminal;
  END Data;
END SmartMeter24.
