INTERLIS 2.4;

MODEL SmartPoly24 AT "https://example.org/smart" VERSION "1" =
  TOPIC Data =
    CLASS Instrument (ABSTRACT) = Memo : TEXT*30; END Instrument;
    CLASS Meter EXTENDS Instrument =
      Counter : 0..100;
      WideValue : 0..50000000000;
      Tilt : -90.00..90.00;
    END Meter;
    CLASS SmartUnit EXTENDS Meter =
      Badge : TEXT*12;
      Counter (EXTENDED) : 0..49;
      WideValue (EXTENDED) : 0..40000000000;
      Tilt (EXTENDED) : -9.50..9.50;
    END SmartUnit;
    CLASS Sensor = State : (idle, active, standby) ORDERED; END Sensor;
    CLASS SmartSensor EXTENDS Sensor =
      Label : TEXT*12;
      State (EXTENDED) : (active (ready, busy), out_of_service);
    END SmartSensor;
    CLASS SensorLeaf EXTENDS SmartSensor = Detail : TEXT*12; END SensorLeaf;
    CLASS Terminal EXTENDS Instrument = Socket : TEXT*12; END Terminal;
    STRUCTURE Note =
      AnyInstrument : REFERENCE TO Instrument;
      SmartTarget : REFERENCE TO SmartUnit;
    END Note;
    CLASS Survey = Details : Note; END Survey;
    ASSOCIATION Observation =
      Observed -- {0..1} Instrument;
      Surveyed -- {0..*} Survey;
    END Observation;
    ASSOCIATION CrossCheck =
      CheckedInstrument -- {0..*} Instrument;
      CheckedSurvey -- {0..*} Survey;
    END CrossCheck;
  END Data;
END SmartPoly24.
