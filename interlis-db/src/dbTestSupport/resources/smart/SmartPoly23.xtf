<?xml version="1.0" encoding="UTF-8"?>
<TRANSFER xmlns="http://www.interlis.ch/INTERLIS2.3">
  <HEADERSECTION VERSION="2.3" SENDER="test"><MODELS><MODEL NAME="SmartPoly23" VERSION="1" URI="https://example.org/smart"/></MODELS></HEADERSECTION>
  <DATASECTION>
    <SmartPoly23.Data BID="fixture-b">
      <SmartPoly23.Data.Survey TID="fixture-survey">
        <Details><SmartPoly23.Data.Note><AnyInstrument REF="fixture-t"/><SmartTarget REF="fixture-s"/></SmartPoly23.Data.Note></Details>
        <Observed REF="fixture-m"/>
      </SmartPoly23.Data.Survey>
      <SmartPoly23.Data.Meter TID="fixture-m"><Memo>meter</Memo><Counter>75</Counter><WideValue>45000000000</WideValue><Tilt>12.50</Tilt></SmartPoly23.Data.Meter>
      <SmartPoly23.Data.SmartUnit TID="fixture-s"><Memo>smart</Memo><Counter>7</Counter><WideValue>35000000000</WideValue><Tilt>-1.25</Tilt><Badge>tag</Badge></SmartPoly23.Data.SmartUnit>
      <SmartPoly23.Data.Sensor TID="fixture-sensor"><State>standby</State></SmartPoly23.Data.Sensor>
      <SmartPoly23.Data.SmartSensor TID="fixture-smart-sensor"><State>active.ready</State><Label>tag</Label></SmartPoly23.Data.SmartSensor>
      <SmartPoly23.Data.SensorLeaf TID="fixture-sensor-leaf"><State>standby</State></SmartPoly23.Data.SensorLeaf>
      <SmartPoly23.Data.Terminal TID="fixture-t"><Memo>terminal</Memo><Socket>p1</Socket></SmartPoly23.Data.Terminal>
      <SmartPoly23.Data.CrossCheck><CheckedInstrument REF="fixture-t"/><CheckedSurvey REF="fixture-survey"/></SmartPoly23.Data.CrossCheck>
      <SmartPoly23.Data.CrossCheck><CheckedInstrument REF="fixture-s"/><CheckedSurvey REF="fixture-survey"/></SmartPoly23.Data.CrossCheck>
    </SmartPoly23.Data>
  </DATASECTION>
</TRANSFER>
