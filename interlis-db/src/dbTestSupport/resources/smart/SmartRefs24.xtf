<?xml version="1.0" encoding="UTF-8"?>
<i:transfer xmlns:i="http://www.interlis.ch/xtf/2.4/INTERLIS" xmlns="http://www.interlis.ch/xtf/2.4/SmartRefs24">
  <i:headersection><i:models><i:model>SmartRefs24</i:model></i:models></i:headersection>
  <i:datasection>
    <Data i:bid="fixture-b">
      <Survey i:tid="fixture-survey">
        <Details><Note><AnyInstrument i:ref="fixture-t"/><SmartTarget i:ref="fixture-s"/></Note></Details>
        <Observed i:ref="fixture-m"/>
      </Survey>
      <Meter i:tid="fixture-m"><Memo>meter</Memo><Counter>75</Counter><WideValue>45000000000</WideValue><Tilt>12.50</Tilt></Meter>
      <SmartUnit i:tid="fixture-s"><Memo>smart</Memo><Counter>7</Counter><WideValue>35000000000</WideValue><Tilt>-1.25</Tilt><Badge>tag</Badge></SmartUnit>
      <Terminal i:tid="fixture-t"><Memo>terminal</Memo><Socket>p1</Socket></Terminal>
      <LocalReading i:tid="fixture-local-reading"><NumericValue>42</NumericValue><RegionCode>local</RegionCode></LocalReading>
      <SpareReading i:tid="fixture-spare-reading"><NumericValue>93</NumericValue><TagCode>spare</TagCode></SpareReading>
    </Data>
  </i:datasection>
</i:transfer>
