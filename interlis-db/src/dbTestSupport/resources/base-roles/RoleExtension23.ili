INTERLIS 2.3;

MODEL RoleExtension23 AT "https://example.org/interlis/db" VERSION "1" =
  IMPORTS RoleBase23;
  TOPIC Work EXTENDS RoleBase23.Data =
    CLASS LocalSurvey EXTENDS RoleBase23.Data.Survey = Crew : TEXT*30; END LocalSurvey;
    CLASS FieldMarker EXTENDS RoleBase23.Data.Marker = END FieldMarker;
    CLASS FieldArchive EXTENDS RoleBase23.Data.Archive = END FieldArchive;
  END Work;
END RoleExtension23.
