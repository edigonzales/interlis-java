INTERLIS 2.4;

MODEL RoleBase24 AT "https://example.org/interlis/db" VERSION "1" =
  TOPIC Data =
    CLASS Marker (ABSTRACT) = END Marker;
    CLASS FixedMarker EXTENDS Marker = END FixedMarker;
    CLASS Survey = Memo : TEXT*30; END Survey;
    ASSOCIATION Assignment =
      Mark -- {0..1} Marker;
      AssignedSurvey -- {0..1} Survey;
    END Assignment;
    CLASS Archive (ABSTRACT) = END Archive;
    CLASS MainArchive EXTENDS Archive = END MainArchive;
    CLASS Document = END Document;
    ASSOCIATION Filing =
      FiledAt -- {0..1} Archive;
      FiledDocument (ORDERED) -- {0..*} Document;
      Remark : TEXT*30;
      Priority : 0 .. 99;
    END Filing;
    CLASS Course = END Course;
    ASSOCIATION Route =
      Follows -- {0..1} Course;
      Stages (ORDERED) -- {0..*} Survey;
    END Route;
    ASSOCIATION Observation =
      ObservedCourse (ORDERED) -- {0..*} Course;
      ObservingSurvey (ORDERED) -- {0..*} Survey;
    END Observation;
  END Data;
END RoleBase24.
