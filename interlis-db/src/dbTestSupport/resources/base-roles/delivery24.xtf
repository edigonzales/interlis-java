<?xml version="1.0" encoding="UTF-8"?>
<i:transfer xmlns:i="http://www.interlis.ch/xtf/2.4/INTERLIS"
            xmlns:e="http://www.interlis.ch/xtf/2.4/RoleExtension24"
            xmlns:b="http://www.interlis.ch/xtf/2.4/RoleBase24">
  <i:headersection><i:models><i:model>RoleExtension24</i:model></i:models></i:headersection>
  <i:datasection>
    <e:Work i:bid="work">
      <e:LocalSurvey i:tid="survey">
        <b:Memo>field work</b:Memo>
        <b:Follows i:ref="course" i:order_pos="21"/>
        <b:Mark i:ref="mark"/>
        <e:Crew>morning team</e:Crew>
      </e:LocalSurvey>
      <b:Survey i:tid="unassigned"><b:Memo>planned</b:Memo><b:Follows i:ref="course"/></b:Survey>
      <b:FixedMarker i:tid="mark"/>
      <b:Document i:tid="detailed">
        <b:FiledAt i:ref="archive" i:order_pos="34"><b:Filing><b:Remark>registered</b:Remark><b:Priority>9</b:Priority></b:Filing></b:FiledAt>
      </b:Document>
      <b:Document i:tid="direct"><b:FiledAt i:ref="archive" i:order_pos="18"/></b:Document>
      <b:Document i:tid="unfiled"/>
      <b:MainArchive i:tid="archive"/>
      <b:Observation>
        <b:ObservedCourse i:ref="course" i:order_pos="3"/><b:ObservingSurvey i:ref="survey" i:order_pos="12"/>
      </b:Observation>
      <b:Observation>
        <b:ObservedCourse i:ref="course"/><b:ObservingSurvey i:ref="unassigned" i:order_pos="2"/>
      </b:Observation>
      <b:Course i:tid="course"/>
    </e:Work>
  </i:datasection>
</i:transfer>
