INTERLIS 2.4;

MODEL DbImportedStruct24 (en) AT "https://example.org/interlis/db" VERSION "1" =
  IMPORTS DbSharedDetail24;
  TOPIC Data =
    CLASS Report =
      Summary : DbSharedDetail24.Detail;
      Entries : LIST {0..*} OF DbSharedDetail24.Detail;
      Observations : BAG {0..*} OF DbSharedDetail24.Detail;
    END Report;
  END Data;
END DbImportedStruct24.
