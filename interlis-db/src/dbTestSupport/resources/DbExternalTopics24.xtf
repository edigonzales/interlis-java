<?xml version="1.0" encoding="UTF-8"?>
<i:transfer xmlns:i="http://www.interlis.ch/xtf/2.4/INTERLIS" xmlns="http://www.interlis.ch/xtf/2.4/DbExternalTopics24">
  <i:headersection><i:models><i:model>DbExternalTopics24</i:model></i:models><i:sender>interop fixture</i:sender></i:headersection>
  <i:datasection>
    <Surveys i:bid="fixture-surveys">
      <SurveyRecord i:tid="fixture-survey">
        <Annotation><SiteAnnotation>
          <AnnotationSite i:ref="fixture-leaf"/>
          <FlatSite i:ref="fixture-landmark"/>
        </SiteAnnotation></Annotation>
        <DirectSite i:ref="fixture-leaf"/>
        <MarkedSite i:ref="fixture-leaf"/>
        <ReviewedAt i:ref="fixture-leaf"><SurveyReview><ReviewMemo>seen</ReviewMemo></SurveyReview></ReviewedAt>
      </SurveyRecord>
      <SurveyMatch><Surveyed i:ref="fixture-leaf"/><MatchedRecord i:ref="fixture-survey"/></SurveyMatch>
      <SitePermit><CoveredSite i:ref="fixture-leaf"/><IssuedPermit i:ref="fixture-permit"/><Reason>access</Reason></SitePermit>
      <PermitRecord i:tid="fixture-permit"/>
    </Surveys>
    <Catalog i:bid="fixture-catalog">
      <SiteLeaf i:tid="fixture-leaf"/>
      <SiteSibling i:tid="fixture-sibling"/>
      <Landmark i:tid="fixture-landmark"/>
    </Catalog>
  </i:datasection>
</i:transfer>
