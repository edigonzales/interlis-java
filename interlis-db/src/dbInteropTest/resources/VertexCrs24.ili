INTERLIS 2.4;
MODEL VertexCrs24 (en) AT "https://example.org/interlis/db" VERSION "1" =
  DOMAIN
    !!@ CRS="EPSG:21781"
    OldXYZ = COORD 460000.000 .. 870000.000, 45000.000 .. 310000.000, -1000.000 .. 9000.000;
    !!@ CRS="EPSG:4326"
    Angles = COORD -180.000 .. 180.000, -90.000 .. 90.000;
  TOPIC Data =
    CLASS Route =
      Trace : POLYLINE WITH (STRAIGHTS) VERTEX OldXYZ;
    END Route;
    CLASS Plot =
      Outline : SURFACE WITH (STRAIGHTS) VERTEX Angles WITHOUT OVERLAPS > 0.001;
    END Plot;
    CLASS Parcel =
      Boundary : AREA WITH (STRAIGHTS) VERTEX OldXYZ WITHOUT OVERLAPS > 0.001;
    END Parcel;
    CLASS Network =
      Routes : MULTIPOLYLINE WITH (STRAIGHTS) VERTEX OldXYZ;
    END Network;

  END Data;
END VertexCrs24.
