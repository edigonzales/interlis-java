INTERLIS 2.3;

MODEL DbStoredImports23 (en) AT "https://example.org/interlis/db" VERSION "1" =
  IMPORTS DbStoredMiddle23, DbStoredTypes23;
  TOPIC Data =
    CLASS Station =
      Name : DbStoredMiddle23.Label;
      State : DbStoredTypes23.Status;
      Location : DbStoredTypes23.Position;
    END Station;
  END Data;
END DbStoredImports23.
