INTERLIS 2.3;

MODEL ChbasePoints23 (en) AT "https://example.org" VERSION "2026-01-01" =
  DOMAIN
    !!@CRS=EPSG:2056
    Location = COORD 2460000.000 .. 2870000.000, 1045000.000 .. 1310000.000;

  STRUCTURE PinPart =
    Position : MANDATORY Location;
  END PinPart;

  !!@ili2db.mapping=MultiPoint
  STRUCTURE PinGroup =
    Members : BAG {1..*} OF PinPart;
  END PinGroup;

  TOPIC Data =
    CLASS PinSet =
      Shape : PinGroup;
    END PinSet;
  END Data;
END ChbasePoints23.
