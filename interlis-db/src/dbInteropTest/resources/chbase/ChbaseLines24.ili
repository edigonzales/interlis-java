INTERLIS 2.4;

TYPE MODEL ChbaseLineTypes24 (en) AT "https://example.org" VERSION "2026-01-01" =
  DOMAIN
    !!@CRS=EPSG:2056
    Coord2 = COORD 2460000.000 .. 2870000.000, 1045000.000 .. 1310000.000;
    Line = POLYLINE WITH (STRAIGHTS, ARCS) VERTEX Coord2;
    DirectedLine EXTENDS Line = DIRECTED POLYLINE;

  STRUCTURE LineStructure =
    Line : Line;
  END LineStructure;
  STRUCTURE DirectedLineStructure =
    Line : DirectedLine;
  END DirectedLineStructure;
  !!@ili2db.mapping=MultiLine
  STRUCTURE MultiLine =
    Lines : BAG {1..*} OF LineStructure;
  END MultiLine;
  !!@ili2db.mapping=MultiLine
  STRUCTURE MultiDirectedLine =
    Lines : BAG {1..*} OF DirectedLineStructure;
  END MultiDirectedLine;
END ChbaseLineTypes24.

MODEL ChbaseLines24 (en) AT "https://example.org" VERSION "2026-01-01" =
  IMPORTS ChbaseLineTypes24;
  TOPIC Data =
    CLASS PipeRoute =
      Shape : ChbaseLineTypes24.MultiLine;
    END PipeRoute;
    CLASS FlowRoute =
      Shape : ChbaseLineTypes24.MultiDirectedLine;
    END FlowRoute;
  END Data;
END ChbaseLines24.
