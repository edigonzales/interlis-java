INTERLIS 2.3;

MODEL DbInterop23 (en) AT "https://example.org/interlis/db" VERSION "2026-11-20" =
  DOMAIN
    Position = COORD 2460000.000 .. 2870000.000, 1045000.000 .. 1310000.000;
    RoutePosition = COORD 2450000.500 .. 2880000.250, 1040000.125 .. 1320000.750;
    PlotPosition = COORD 2440000.125 .. 2885000.750, 1035000.500 .. 1325000.250;

  TOPIC Data =
    CLASS Place =
      Select : TEXT*40;
      Active : BOOLEAN;
      Count : -100 .. 100;
      Status : (draft, approved);
      Geometry : Position;
    END Place;
    CLASS Route =
      Trace : POLYLINE WITH (STRAIGHTS, ARCS) VERTEX RoutePosition;
    END Route;
    CLASS Plot =
      Footprint : SURFACE WITH (STRAIGHTS, ARCS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END Plot;
    CLASS Parcel =
      Boundary : AREA WITH (STRAIGHTS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END Parcel;
    STRUCTURE Detail =
      Label : TEXT*16;
      Enabled : BOOLEAN;
      Quantity : -20 .. 20;
      Decision : (draft, approved);
    END Detail;
    CLASS Report =
      Summary : Detail;
      Entries : LIST {0..*} OF Detail;
    END Report;
  END Data;
END DbInterop23.
