INTERLIS 2.3;

MODEL DbInterop23 (en) AT "https://example.org/interlis/db" VERSION "2026-11-20" =
  DOMAIN
    Position = COORD 2460000.000 .. 2870000.000, 1045000.000 .. 1310000.000;
    RoutePosition = COORD 2450000.500 .. 2880000.250, 1040000.125 .. 1320000.750;
    PlotPosition = COORD 2440000.125 .. 2885000.750, 1035000.500 .. 1325000.250;

  TOPIC Data =
    CLASS Place =
      Select : TEXT*40;
      Active : BOOLEAN;
      Count : -100 .. 100;
      Status : (draft, approved);
      Geometry : Position;
    END Place;
    CLASS Route =
      Trace : POLYLINE WITH (STRAIGHTS, ARCS) VERTEX RoutePosition;
    END Route;
    CLASS Plot =
      Footprint : SURFACE WITH (STRAIGHTS, ARCS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END Plot;
    CLASS Parcel =
      Boundary : AREA WITH (STRAIGHTS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END Parcel;
    STRUCTURE Detail =
      Label : TEXT*16;
      Enabled : BOOLEAN;
      Quantity : -20 .. 20;
      Decision : (draft, approved);
    END Detail;
    STRUCTURE LinkDetail =
      Label : TEXT*16;
      Destination : REFERENCE TO Place;
    END LinkDetail;
    STRUCTURE NestedLeaf =
      Amount : 0 .. 10;
    END NestedLeaf;
    STRUCTURE NestedInner =
      Headline : TEXT*16;
      Main : NestedLeaf;
      Values : LIST {0..*} OF NestedLeaf;
      Extras : BAG {0..*} OF NestedLeaf;
    END NestedInner;
    STRUCTURE NestedOuter =
      Items : LIST {0..*} OF NestedInner;
    END NestedOuter;
    CLASS NestedRecord =
      Tree : NestedOuter;
    END NestedRecord;
    CLASS Report =
      Summary : Detail;
      Entries : LIST {0..*} OF Detail;
      Observations : BAG {0..*} OF Detail;
      Links : LIST {0..*} OF LinkDetail;
    END Report;
    CLASS Marker =
      ASelect : TEXT*16;
    END Marker;
    CLASS Hub =
    END Hub;
    ASSOCIATION MarkerHub =
      Select -- {0..1} Hub;
      Markers -- {0..*} Marker;
    END MarkerHub;
    ASSOCIATION MarkerLink =
      LinkedMarker -- {0..*} Marker;
      LinkedHub -- {0..*} Hub;
    END MarkerLink;
    ASSOCIATION Review =
      Witness -- {0..1} Hub;
      ReviewMarkers -- {0..*} Marker;
      Memo : TEXT*16;
      Grade : -8 .. 8;
    END Review;
    ASSOCIATION AnnotatedLink =
      ConsultedMarker -- {0..*} Marker;
      ConsultedReport -- {0..*} Report;
      Memo : TEXT*16;
      Grade : -8 .. 8;
      LocalDecision : (draft, approved);
    END AnnotatedLink;
    CLASS PairLeft =
    END PairLeft;
    CLASS PairRight =
    END PairRight;
    ASSOCIATION Pairing =
      LeftLink -- {1} PairLeft;
      RightLink -- {0..1} PairRight;
    END Pairing;
  END Data;
END DbInterop23.
