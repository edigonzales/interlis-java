INTERLIS 2.3;

CONTRACTED MODEL DbOid23 (en) AT "https://example.org/interlis/db" VERSION "1" =
  TOPIC Data =
    BASKET OID AS INTERLIS.UUIDOID;
    CLASS Site =
      OID AS INTERLIS.UUIDOID;
      Label : TEXT*40;
    END Site;
    CLASS Marker EXTENDS Site =
      Category : TEXT*20;
    END Marker;
    STRUCTURE InspectionRefs =
      LocalSite : REFERENCE TO Site;
      RemoteSite : REFERENCE TO (EXTERNAL) Marker;
    END InspectionRefs;
    CLASS Inspection =
      Links : InspectionRefs;
    END Inspection;
    ASSOCIATION Evidence (OID) =
      OID AS INTERLIS.UUIDOID;
      EvidenceMarker -- {0..*} Marker;
      EvidenceInspection -- {0..*} Inspection;
      Memo : TEXT*40;
    END Evidence;
  END Data;
  TOPIC Defaults =
    OID AS INTERLIS.UUIDOID;
    CLASS Address =
      Text : TEXT*40;
    END Address;
  END Defaults;
END DbOid23.
