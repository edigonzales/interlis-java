INTERLIS 2.4;

!!@ CRS=EPSG:21781
MODEL DbInterop24 (en) AT "https://example.org/interlis/db" VERSION "2026-11-20" =
  DOMAIN
    !!@ CRS=EPSG:02056
    Position = COORD 2460000.000 .. 2870000.000, 1045000.000 .. 1310000.000;
    !!@ CRS=EPSG:02056
    RoutePosition = COORD 2450000.500 .. 2880000.250, 1040000.125 .. 1320000.750;
    !!@ CRS=EPSG:02056
    PlotPosition = COORD 2440000.125 .. 2885000.750, 1035000.500 .. 1325000.250;
    Approval = (draft, approved);

  TOPIC Data =
    !!@ ili2db.dispName="Places"
    CLASS Place =
      !!@ ili2db.dispName="Label"
      Select : TEXT*40;
      Active : BOOLEAN;
      Count : -100 .. 100;
      Status : Approval;
      Geometry : Position;
    END Place;
    CLASS Route =
      Trace : POLYLINE WITH (STRAIGHTS, ARCS) VERTEX RoutePosition;
    END Route;
    CLASS Link =
      Target : REFERENCE TO Place;
    END Link;
    CLASS Plot =
      Footprint : SURFACE WITH (STRAIGHTS, ARCS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END Plot;
    CLASS Parcel =
      Boundary : AREA WITH (STRAIGHTS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END Parcel;
    CLASS Park =
      Coverage : MULTISURFACE WITH (STRAIGHTS, ARCS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END Park;
    CLASS District =
      Coverage : MULTIAREA WITH (STRAIGHTS, ARCS) VERTEX PlotPosition WITHOUT OVERLAPS > 0.001;
    END District;
  END Data;

  TOPIC Naming =
    CLASS place =
      Select : TEXT*40;
      ASelect : TEXT*40;
      LongAttributeNameWithAnUnusuallyLongMiddleSectionForTestingShorteningAboveTheLimit : TEXT;
    END place;
    CLASS LongClassNameWithAnUnusuallyLongMiddleSectionForTestingShorteningAboveTheLimit =
      Number : 0 .. 5;
    END LongClassNameWithAnUnusuallyLongMiddleSectionForTestingShorteningAboveTheLimit;
  END Naming;
END DbInterop24.
