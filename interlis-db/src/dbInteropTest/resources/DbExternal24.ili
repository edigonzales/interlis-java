INTERLIS 2.4;

MODEL DbExternal24 (en) AT "https://example.org/interlis/db" VERSION "1" =
  TOPIC Data =
    CLASS TargetRoot (ABSTRACT) = END TargetRoot;
    CLASS TargetBranch EXTENDS TargetRoot = END TargetBranch;
    CLASS TargetLeaf EXTENDS TargetBranch = END TargetLeaf;
    CLASS TargetSibling EXTENDS TargetRoot = END TargetSibling;

    STRUCTURE Detail =
      Note : TEXT*40;
      TargetRef : REFERENCE TO (EXTERNAL) TargetBranch;
    END Detail;

    CLASS Report =
      DetailValue : Detail;
      DirectRef : REFERENCE TO (EXTERNAL) TargetBranch;
    END Report;
    ASSOCIATION ReportPlace =
      PlaceReports -- {0..*} Report;
      BaseSite (EXTERNAL) -- {0..1} TargetBranch;
    END ReportPlace;
    ASSOCIATION ReportPairing =
      PairedSite (EXTERNAL) -- {0..1} TargetBranch;
      PairedReport -- {0..1} Report;
    END ReportPairing;
    ASSOCIATION ExternalPair =
      PairObject -- {0..*} Report;
      PairTarget (EXTERNAL) -- {0..*} TargetBranch;
    END ExternalPair;
    ASSOCIATION ExternalReview =
      ReviewOwner -- {0..*} Report;
      ReviewSite (EXTERNAL) -- {0..1} TargetBranch;
      ReviewMemo : TEXT*20;
    END ExternalReview;
  END Data;
END DbExternal24.
