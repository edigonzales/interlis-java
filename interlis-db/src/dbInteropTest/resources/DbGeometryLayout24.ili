INTERLIS 2.4;
MODEL DbGeometryLayout24 (en) AT "https://example.org/interlis/db" VERSION "1" =
  DOMAIN
    XY = COORD 2460000.125 .. 2870000.750, 1045000.500 .. 1310000.250;
    XYZ = COORD 2460100.125 .. 2870100.750, 1045100.500 .. 1310100.250, -999.125 .. 999.875;
  TOPIC Data =
    CLASS Asset =
      Anchor : XY;
      Surveyed : XYZ;
      Trace : POLYLINE WITH (STRAIGHTS) VERTEX XY;
    END Asset;
    CLASS Device (ABSTRACT) =
      Origin : XYZ;
    END Device;
    CLASS Recorder EXTENDS Device =
      Peg : XY;
      Track : POLYLINE WITH (STRAIGHTS) VERTEX XYZ;
    END Recorder;
    CLASS Beacon EXTENDS Device =
      Signal : XY;
    END Beacon;
  END Data;
END DbGeometryLayout24.
