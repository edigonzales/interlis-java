<i:transfer xmlns:i="http://www.interlis.ch/xtf/2.4/INTERLIS" xmlns="http://www.interlis.ch/xtf/2.4/DbExternalTopics24">
  <i:headersection><i:models><i:model>DbExternalTopics24</i:model></i:models><i:sender>interop fixture</i:sender></i:headersection>
  <i:datasection>
