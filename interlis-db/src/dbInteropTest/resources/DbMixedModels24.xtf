<?xml version="1.0" encoding="UTF-8"?>
<i:transfer xmlns:i="http://www.interlis.ch/xtf/2.4/INTERLIS"
    xmlns:a="http://www.interlis.ch/xtf/2.4/DbWarehouse24" xmlns:b="http://www.interlis.ch/xtf/2.4/DbWorkshop24">
  <i:headersection><i:models><i:model>DbWarehouse24</i:model><i:model>DbWorkshop24</i:model></i:models><i:sender>mixed model fixture</i:sender></i:headersection>
  <i:datasection>
    <a:Data i:bid="mixed-warehouse-basket">
      <a:Entry i:tid="mixed-warehouse-entry"><a:Memo>warehouse</a:Memo></a:Entry>
    </a:Data>
    <b:Data i:bid="mixed-workshop-basket">
      <b:Entry i:tid="mixed-workshop-entry"><b:Memo>workshop</b:Memo></b:Entry>
    </b:Data>
  </i:datasection>
</i:transfer>
