INTERLIS 2.4;

MODEL DbOid24 (en) AT "https://example.org/interlis/db" VERSION "1" =
  TOPIC Data =
    CLASS Site =
      OID AS INTERLIS.UUIDOID;
      Label : TEXT*40;
    END Site;
    CLASS Marker EXTENDS Site =
      Category : TEXT*20;
    END Marker;
  END Data;
  TOPIC Defaults =
    OID AS INTERLIS.UUIDOID;
    CLASS Address =
      Text : TEXT*40;
    END Address;
  END Defaults;
END DbOid24.
