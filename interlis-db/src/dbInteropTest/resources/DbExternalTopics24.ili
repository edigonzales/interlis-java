INTERLIS 2.4;
MODEL DbExternalTopics24 (en) AT "https://example.org/interlis/db" VERSION "2026-11-21" =
  TOPIC Catalog =
    CLASS Registry (ABSTRACT) = END Registry;
    CLASS RegisteredSite EXTENDS Registry = END RegisteredSite;
    CLASS SiteLeaf EXTENDS RegisteredSite = END SiteLeaf;
    CLASS SiteSibling EXTENDS Registry = END SiteSibling;
    CLASS Landmark = END Landmark;
  END Catalog;
  TOPIC Surveys =
    DEPENDS ON DbExternalTopics24.Catalog;
    STRUCTURE SiteAnnotation =
      AnnotationSite : REFERENCE TO (EXTERNAL) DbExternalTopics24.Catalog.RegisteredSite;
      FlatSite : REFERENCE TO (EXTERNAL) DbExternalTopics24.Catalog.Landmark;
    END SiteAnnotation;
    CLASS SurveyRecord =
      Annotation : SiteAnnotation;
      DirectSite : REFERENCE TO (EXTERNAL) DbExternalTopics24.Catalog.RegisteredSite;
    END SurveyRecord;
    ASSOCIATION SurveyArea =
      Areas -- {0..*} SurveyRecord;
      MarkedSite (EXTERNAL) -- {0..1} DbExternalTopics24.Catalog.RegisteredSite;
    END SurveyArea;
    ASSOCIATION SurveyReview =
      Reviews -- {0..*} SurveyRecord;
      ReviewedAt (EXTERNAL) -- {0..1} DbExternalTopics24.Catalog.RegisteredSite;
      ReviewMemo : TEXT*20;
    END SurveyReview;
    CLASS PermitRecord = END PermitRecord;
    ASSOCIATION SurveyMatch =
      Surveyed (EXTERNAL) -- {0..*} DbExternalTopics24.Catalog.RegisteredSite;
      MatchedRecord -- {0..*} SurveyRecord;
    END SurveyMatch;
    ASSOCIATION SitePermit =
      CoveredSite (EXTERNAL) -- {0..*} DbExternalTopics24.Catalog.RegisteredSite;
      IssuedPermit -- {1} PermitRecord;
      Reason : TEXT*20;
    END SitePermit;
  END Surveys;
END DbExternalTopics24.
