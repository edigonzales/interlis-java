INTERLIS 2.4;

MODEL DbStoredImports24 (en) AT "https://example.org/interlis/db" VERSION "1" =
  IMPORTS DbStoredMiddle24, DbStoredTypes24;
  TOPIC Data =
    CLASS Station =
      Name : DbStoredMiddle24.Label;
      State : DbStoredTypes24.Status;
      Location : DbStoredTypes24.Position;
    END Station;
  END Data;
END DbStoredImports24.
