INTERLIS 2.3;

MODEL DbExternal23 (en) AT "https://example.org/interlis/db" VERSION "1" =
  TOPIC Data =
    CLASS TargetRoot (ABSTRACT) = END TargetRoot;
    CLASS TargetBranch EXTENDS TargetRoot = END TargetBranch;
    CLASS TargetLeaf EXTENDS TargetBranch = END TargetLeaf;
    CLASS TargetSibling EXTENDS TargetRoot = END TargetSibling;

    STRUCTURE Detail =
      Note : TEXT*40;
      TargetRef : REFERENCE TO (EXTERNAL) TargetBranch;
    END Detail;

    CLASS Report =
      DetailValue : Detail;
    END Report;
    ASSOCIATION ReportPlace =
      PlaceReports -- {0..*} Report;
      BaseSite (EXTERNAL) -- {0..1} TargetBranch;
    END ReportPlace;
    ASSOCIATION ReportPairing =
      PairedSite (EXTERNAL) -- {0..1} TargetBranch;
      PairedReport -- {0..1} Report;
    END ReportPairing;
  END Data;
END DbExternal23.
