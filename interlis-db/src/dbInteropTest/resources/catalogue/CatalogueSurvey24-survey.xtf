<?xml version="1.0" encoding="UTF-8"?>
<i:transfer xmlns:i="http://www.interlis.ch/xtf/2.4/INTERLIS"
    xmlns="http://www.interlis.ch/xtf/2.4/CatalogueSurvey24" xmlns:c="http://www.interlis.ch/xtf/2.4/CatalogueObjects_V1">
  <i:headersection><i:models><i:model>CatalogueSurvey24</i:model></i:models></i:headersection>
  <i:datasection>
    <Survey i:bid="survey-b">
      <Asset i:tid="survey-a">
        <MainMaterial><MaterialRef><c:Reference i:ref="material-a"/></MaterialRef></MainMaterial>
        <RequiredMaterial><MaterialMandatory><c:Reference i:ref="material-a"/></MaterialMandatory></RequiredMaterial>
      </Asset>
      <Asset i:tid="survey-empty"><MainMaterial><MaterialRef/></MainMaterial></Asset>
      <Asset i:tid="survey-absent"/>
    </Survey>
  </i:datasection>
</i:transfer>
