INTERLIS 2.4; MODEL Example AT "https://example.org" VERSION "1" = TOPIC Data =
CLASS Entry =
EXISTENCE CONSTRAINT Check : ExternalIdentifier REQUIRED IN Catalogue.Entry: Identifier OR OtherCatalogue.Entry: OtherIdentifier;
UNIQUE (BASKET) Named: WHERE DEFINED(FirstKey): FirstKey, SecondKey, ThirdKey;
UNIQUE (LOCAL) Details->Subdetails: FirstKey, SecondKey;
SET CONSTRAINT (BASKET) First: WHERE DEFINED(FirstKey): DEFINED(ReallyLongAttributeName);
SET CONSTRAINT WHERE DEFINED(SecondKey): Second: DEFINED(ReallyLongAttributeName);
END Entry; END Data; END Example.
