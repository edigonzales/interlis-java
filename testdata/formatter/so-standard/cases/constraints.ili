INTERLIS 2.4; MODEL Example AT "https://example.org" VERSION "1" = TOPIC Data =
STRUCTURE Detail = Key: TEXT; END Detail;
CLASS Entry = A: TEXT; B: TEXT; Parts: BAG {0..*} OF Detail;
MANDATORY CONSTRAINT Check: DEFINED(A) AND (DEFINED(B) OR NOT (A==B));
CONSTRAINT >= 90.00% DEFINED(A);
CONSTRAINT <= 10.00% NOT (DEFINED(B));
EXISTENCE CONSTRAINT A REQUIRED IN Entry: B OR Entry: A;
UNIQUE (BASKET) Named: WHERE DEFINED(A): A,B;
UNIQUE (LOCAL) Parts: Key;
SET CONSTRAINT (BASKET) First: WHERE DEFINED(A): DEFINED(B);
SET CONSTRAINT WHERE DEFINED(B): Second: DEFINED(A);
END Entry; END Data; END Example.
