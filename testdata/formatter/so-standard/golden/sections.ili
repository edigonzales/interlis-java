INTERLIS 2.4;

CONTRACTED MODEL M AT "x" VERSION "1" =

  UNIT
    Length (ABSTRACT);
    Time (ABSTRACT);
    Meter [m] EXTENDS Length;

  DOMAIN
    D = 0 .. 999
      [INTERLIS.m];
    E = (
      one (
        subOne,
        subTwo
      ),
      two
    );

  FUNCTION f(x : TEXT; y : TEXT) : TEXT;

  TOPIC T =

    CLASS S EXTENDS INTERLIS.SIGN =
      PARAMETER
        A : MANDATORY 0 .. 10;
    END S;

  END T;

  SIGN BASKET Library ~ T
    OBJECTS OF S : Dot;
    OBJECTS OF S : Dot2;

  TOPIC Data =

    CLASS C =
      x : TEXT;
      y : NUMERIC {Planar};
    END C;

    VIEW V PROJECTION OF C; =
      ATTRIBUTE
        ALL OF C;
    END V;

    GRAPHIC G BASED ON C =
      Draw OF M.T.S :
        WHERE x == "a" (
          Sign := {Dot};
          A := 1
        ),
        (
          Sign := {Dot2};
          A := 2
        );
    END G;

    CONSTRAINTS OF C =
      MANDATORY CONSTRAINT DEFINED(x);
    END;

  END Data;

END M.
