INTERLIS 2.3;
MODEL Contact AT "https://example.org/contact" VERSION "1" =
TOPIC Data =
DOMAIN P = COORD -1.000000000000000000 .. 20.000000000000000000,
                 -1.000000000000000000 .. 20.000000000000000000, ROTATION 2 -> 1;
CLASS Piece =
  shape : SURFACE WITH (STRAIGHTS) VERTEX P WITHOUT OVERLAPS > 0.000000000000000001;
END Piece;
END Data;
END Contact.
