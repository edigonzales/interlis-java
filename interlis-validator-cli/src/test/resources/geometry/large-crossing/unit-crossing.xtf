<?xml version="1.0" encoding="UTF-8"?>
<i:transfer xmlns="http://www.interlis.ch/xtf/2.4/Huge" xmlns:g="http://www.interlis.ch/geometry/1.0" xmlns:i="http://www.interlis.ch/xtf/2.4/INTERLIS">
  <i:headersection>
    <i:models>
      <i:model>Huge</i:model>
    </i:models>
    <i:sender>witness-review</i:sender>
  </i:headersection>
  <i:datasection>
    <Data i:bid="review">
      <AreaPart i:tid="var">
        <shape>
          <g:surface>
            <g:exterior>
              <g:polyline>
                <g:coord>
                  <g:c1>0</g:c1>
                  <g:c2>0</g:c2>
                </g:coord>
                <g:coord>
                  <g:c1>4</g:c1>
                  <g:c2>4</g:c2>
                </g:coord>
                <g:coord>
                  <g:c1>1</g:c1>
                  <g:c2>2</g:c2>
                </g:coord>
                <g:coord>
                  <g:c1>4</g:c1>
                  <g:c2>1</g:c2>
                </g:coord>
                <g:coord>
                  <g:c1>0</g:c1>
                  <g:c2>0</g:c2>
                </g:coord>
              </g:polyline>
            </g:exterior>
          </g:surface>
        </shape>
      </AreaPart>
    </Data>
  </i:datasection>
</i:transfer>
