INTERLIS 2.3;
MODEL Checks (en) AT "https://example.org/interlis/checks" VERSION "1" =
  TOPIC Data =
    STRUCTURE Detail =
      key : TEXT*8;
    END Detail;
    CLASS Item =
      code : MANDATORY TEXT*3;
      count : 0..9;
      active : BOOLEAN;
      details : BAG {0..*} OF Detail;
      point : COORD 0.00..100.00, 0.00..100.00;
      MANDATORY CONSTRAINT active == #true;
      UNIQUE (LOCAL) details: key;
      UNIQUE count;
    END Item;
  END Data;
END Checks.
