{
  "name": "@interlis/diagram-ui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "Own neutral INTERLIS DiagramDocument viewer shared by browser and VS Code",
  "exports": {
    ".": {
      "types": "./dist/interactive.d.ts",
      "import": "./dist/diagram-ui.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "require": "./dist/adapter.cjs"
    }
  },
  "files": [
    "dist",
    "UPSTREAM-LICENSE",
    "LICENSE",
    "ELK-LICENSE.md",
    "provenance.json"
  ],
  "scripts": {
    "build": "node build.cjs",
    "test": "node --test test/*.test.cjs",
    "pretest": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "elkjs": "0.11.0",
    "sprotty": "1.4.0",
    "sprotty-protocol": "1.4.0",
    "inversify": "6.1.3",
    "reflect-metadata": "0.2.2",
    "snabbdom": "3.5.1",
    "libavoid-js": "0.5.0-beta.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "playwright": "1.64.1"
  }
}
