{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compiler GUI Swing independent phase review verdict",
  "description": "Structural validation only. The runner must additionally verify exact criterion set, commit/tree binding, real process completion, provider/model, source integrity and evidence files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assignment",
    "phaseId",
    "baseSha",
    "phaseBaseSha",
    "candidateSha",
    "candidateTree",
    "verdict",
    "summary",
    "criteria",
    "independentChecks",
    "findings",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "assignment": {
      "const": "compiler-gui-swing"
    },
    "phaseId": {
      "enum": [
        "G0",
        "G1",
        "G2",
        "G3",
        "G4",
        "G5",
        "G6"
      ]
    },
    "baseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "phaseBaseSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidateSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "candidateTree": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 52,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "assessment",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^GUI-(0[1-9]|[1-4][0-9]|5[0-2])$"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "FAIL"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "independentChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "commandLog",
          "expected",
          "observed",
          "exitCode",
          "status"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "commandLog": {
            "type": "string",
            "minLength": 1
          },
          "expected": {
            "type": "string",
            "minLength": 1
          },
          "observed": {
            "type": "string",
            "minLength": 1
          },
          "exitCode": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criteria",
          "severity",
          "blocking",
          "location",
          "impact",
          "reproduction",
          "minimumRetest"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^GUI-(0[1-9]|[1-4][0-9]|5[0-2])$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor",
              "suggestion"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "reproduction": {
            "type": "string",
            "minLength": 1
          },
          "minimumRetest": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "criteria": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          },
          "independentChecks": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          },
          "findings": {
            "items": {
              "properties": {
                "blocking": {
                  "const": false
                }
              }
            }
          }
        }
      }
    }
  ]
}
