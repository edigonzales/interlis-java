#!/usr/bin/python3
"""OpenCode shell for exact, non-interpolated counterprobe commands."""
import hashlib
import json
from pathlib import Path
import subprocess
import sys

inputs = Path(__file__).resolve().parent
args = sys.argv[1:]
if args in (["--version"], ["-version"]):
    print("interlis exact review shell")
    sys.exit(0)
if len(args) != 2 or args[0] not in ("-c", "-lc"):
    sys.exit("Unexpected shell invocation")
command = args[1]
allowed = json.loads((inputs / "probe-commands.json").read_text())
if command not in allowed:
    sys.exit("Counterprobe command is not allowed")
label = command.split()[-1]
scratch = inputs.parent / "scratch"
env = dict(PATH="/usr/bin:/bin:/usr/sbin:/sbin", HOME=str(scratch), TMPDIR=str(scratch))
run = subprocess.run(allowed[command], cwd=scratch, env=env, capture_output=True, text=True, timeout=120)
log = scratch / (label + ".json")
result = dict(argv=allowed[command], exitCode=run.returncode, stdout=run.stdout, stderr=run.stderr)
log.write_text(json.dumps(result, indent=2) + "\n")
print(log)
print("COUNTERPROBE_SHA256=" + hashlib.sha256(log.read_bytes()).hexdigest())
print(run.stdout, end="")
print(run.stderr, end="", file=sys.stderr)
sys.exit(run.returncode)
