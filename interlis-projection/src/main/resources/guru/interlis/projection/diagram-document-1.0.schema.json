{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://interlis.ch/schema/diagram-document-1.0.schema.json",
  "title": "DiagramDocument 1.0",
  "type": "object",
  "required": ["schemaVersion", "snapshotId", "sourceRevisions", "inputKind", "completeness",
    "selection", "optionsFingerprint", "containers", "nodes", "edges", "notices"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "snapshotId": {"type": "string", "minLength": 1},
    "sourceRevisions": {"type": "object", "additionalProperties": {"type": "string"}},
    "inputKind": {"type": "string"},
    "completeness": {"type": "string"},
    "selection": {"type": "array", "items": {"type": "object"}},
    "optionsFingerprint": {"type": "string"},
    "containers": {"type": "array", "items": {"type": "object"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "notices": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": {"type": "string"},
        "range": {"type": "object"}
      },
      "additionalProperties": true
    },
    "node": {
      "type": "object",
      "required": ["id", "kind", "label", "canonicalName", "status", "compartments"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "containerId": {"type": "string"},
        "label": {"type": "string"},
        "canonicalName": {"type": "string"},
        "status": {"type": "string"},
        "symbol": {"type": ["object", "null"]},
        "compartments": {"type": "array", "items": {"type": "object"}},
        "anchor": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/anchor"}]}
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": ["id", "kind", "source", "target", "label", "sourceEnd", "targetEnd"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string"},
        "source": {"type": "object"},
        "target": {"type": "object"},
        "origin": {"type": ["object", "null"]},
        "sourceEnd": {"type": "object"},
        "targetEnd": {"type": "object"},
        "label": {"type": "string"},
        "anchor": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/anchor"}]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
