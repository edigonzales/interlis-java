INTERLIS 2.3;
MODEL NoiseZones AT "https://example.org/noise-zones" VERSION "1" =
  TOPIC Zones =
    DOMAIN Point = COORD 2460000.000 .. 2870000.000, 1045000.000 .. 1310000.000, ROTATION 2 -> 1;
    CLASS Zone =
      shape : AREA WITH (ARCS, STRAIGHTS) VERTEX Point WITHOUT OVERLAPS > 0.05;
    END Zone;
  END Zones;
END NoiseZones.
